<!DOCTYPE html>
<html lang="en" data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    
    <!-- Meta Tags -->
    {{#if description}}
    <meta name="description" content="{{description}}">
    {{/if}}
    {{#if author}}
    <meta name="author" content="{{author}}">
    {{/if}}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}">
    <meta property="og:title" content="{{title}}">
    {{#if description}}
    <meta property="og:description" content="{{description}}">
    {{/if}}
    {{#if ogImage}}
    <meta property="og:image" content="{{ogImage}}">
    {{/if}}
    {{#if ogUrl}}
    <meta property="og:url" content="{{ogUrl}}">
    {{/if}}
    <meta property="og:site_name" content="MMRL">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="{{#if twitterCard}}{{twitterCard}}{{else}}summary_large_image{{/if}}">
    <meta name="twitter:title" content="{{title}}">
    {{#if description}}
    <meta name="twitter:description" content="{{description}}">
    {{/if}}
    {{#if ogImage}}
    <meta name="twitter:image" content="{{ogImage}}">
    {{/if}}
    
    <link rel="stylesheet" href="{{basePath}}assets/github-style.css">
    <link rel="stylesheet" href="{{basePath}}assets/highlight.css">
</head>
<body>
    <div class="page-container">
        <!-- Header -->
        <header class="Header">
            <div class="Header-item">
                <a href="{{basePath}}" class="Header-link">
                    <svg height="32" aria-hidden="true" viewBox="0 0 16 16" version="1.1" width="32" class="octicon">
                        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                    </svg>
                    <span class="Header-title">Module Explorer</span>
                </a>
            </div>
            <div class="Header-item Header-item--full">
                {{#if showSearch}}
                <div class="header-search">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search modules..." aria-label="Search">
                </div>
                {{/if}}
            </div>
            <div class="Header-item">
                <button id="themeToggle" class="btn-icon" aria-label="Toggle theme">
                    <svg class="octicon sun-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0Zm-9.193 9.193a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm13 0a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8Zm-.343-5.657a.75.75 0 0 1 1.061 0 .75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061ZM8 14a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 14Zm-2.343-1.657a.75.75 0 0 1-1.061 0l-1.06-1.06a.75.75 0 1 1 1.06-1.061l1.061 1.06a.75.75 0 0 1 0 1.061Z"></path>
                    </svg>
                    <svg class="octicon moon-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="display: none;">
                        <path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            {{{content}}}
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="container-lg">
                <p>Generated at {{generatedAt}}</p>
            </div>
        </footer>
    </div>

    <script src="{{basePath}}assets/main.js"></script>
</body>
</html>
